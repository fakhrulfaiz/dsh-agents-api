{
  "name": "@agentry/api",
  "description": "OpenAI Agents API HTTP gateway for DeepSeek Harness",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fakhrulfaiz/agentry-api.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./sandbox-runtime": {
      "default": "./lib/sandbox-runtime.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/*.js",
    "lib/migrations/*.sql",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "fflate": "0.8.3",
    "jose": "6.2.3",
    "pg": "^8.23.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-ssh": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-ptc-runtime-node": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-ssh": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-schedule": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-ssh": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-ssh": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": ">=0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=0.0.1-0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-ssh": {
      "optional": true
    },
    "@deepseek-ai/dsh-ptc-runtime-node": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-ssh": {
      "optional": true
    },
    "@deepseek-ai/dsh-schedule": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-ssh": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess-ssh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentry/sandbox": "link:../agentry-sandbox",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  },
  "scripts": {
    "dsh:link": "tsx scripts/link-dsh.ts",
    "keys:create": "tsx scripts/keys-create.ts",
    "check:dsh-pin": "tsx scripts/check-dsh-pin.ts",
    "typecheck": "pnpm check:dsh-pin && pnpm dsh:link && tsc -p tsconfig.typecheck.json && tsc -p tsconfig.test.json",
    "test": "pnpm check:dsh-pin && pnpm dsh:link && vitest run",
    "build": "pnpm check:dsh-pin && pnpm dsh:link && tsdown && tsc -p tsconfig.types.json"
  }
}
