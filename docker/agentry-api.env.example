# Agentry API settings (docker/compose.yaml reads this file as .env).
# Docker reads values literally: no quotes, no spaces around "=".

# Image tag to run (a release version, or latest).
AGENTRY_API_TAG=latest

# Password of the bundled Postgres; letters and digits only (it goes into a URL):
# openssl rand -hex 24. Keep it: it is set when the database is first created.
POSTGRES_PASSWORD=

# Or use another database instead of the bundled one:
# AGENTRY_DATABASE_URL=postgres://<user>:<password>@<host>:5432/agentry

# The API key clients (and Agentry Web users) sign in with; owner "dev".
AGENTRY_DEV_KEY=

# Model provider key(s). DeepSeek:
DEEPSEEK_API_KEY=

# Optional: Composio Connect (apps for agents). Unset, that one entry does not start.
COMPOSIO_API_KEY=

# Optional: Agentry Sandbox (isolated sandboxes). Set URL and key both or neither.
# To run the service from this compose file too (Linux), set COMPOSE_PROFILES=sandbox and the secret as well.
# AGENTRY_SANDBOX_URL=http://host.docker.internal:3090
# AGENTRY_SANDBOX_KEY=            # openssl rand -hex 32 (the service stores only its hash)
# AGENTRY_SANDBOX_SECRET=         # profile sandbox: at least 32 bytes, openssl rand -base64 48; keep it stable
# AGENTRY_SANDBOX_ADMIN_KEY=      # profile sandbox, optional: turns on http://<host>:3090/admin

# Optional: the address clients use, when behind a proxy (printed links, DSH web UI).
# AGENTRY_PUBLIC_URL=https://agentry.example.com/

# Optional: host port (default 3080, bound to 127.0.0.1).
# AGENTRY_API_PORT=3080

# Optional: set to off to connect agents to Composio directly instead of through the API's local relay (default on).
# AGENTRY_COMPOSIO_RELAY=off
# AGENTRY_COMPOSIO_RELAY_CACHE_DIR=/data/dsh/agentry-composio-relay
